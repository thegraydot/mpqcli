<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Makes UTF-8 the process code page on Windows 10 version 1903 and later. argv,
  std::filesystem's narrow conversions and StormLib's char file APIs then all use the
  UTF-8 the core works in, as they do on Linux. Older Windows ignores the setting.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
